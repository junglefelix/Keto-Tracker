<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Keto_Tracker2.App">
    <Application.Resources>
        <ResourceDictionary>

            <Color x:Key="KetoGreen">#4CAF50</Color>
            <Color x:Key="KetoRed">#F44336</Color>
            <Color x:Key="KetoBlue">#2196F3</Color>
            <Color x:Key="KetoGray">#BDBDBD</Color>
            <Color x:Key="DarkBg">#1E1E2E</Color>
            <Color x:Key="CardBg">#2D2D44</Color>

            <Style x:Key="DayHeaderLabel" TargetType="Label">
                <Setter Property="TextColor" Value="#BDBDBD" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="TextColor" Value="#BDBDBD" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#2D2D44" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
