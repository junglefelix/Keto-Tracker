<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Keto_Tracker2.Converters"
    x:Class="Keto_Tracker2.Views.WeightTrendPage"
    Shell.PresentationMode="ModalAnimated"
    Title="Weight Trend"
    BackgroundColor="#1E1E2E">

    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Weight Trend — Full History"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Close"
                    BackgroundColor="Transparent"
                    TextColor="#4FC3F7"
                    Clicked="OnCloseClicked" />
        </Grid>

        <!-- Range buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="30D"
                    BackgroundColor="#2D2D44"
                    TextColor="#9E9EC8"
                    CornerRadius="8"
                    Command="{Binding SelectRangeCommand}"
                    CommandParameter="30D">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Is30DSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FC3F7" />
                        <Setter Property="TextColor" Value="#1E1E2E" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="90D"
                    BackgroundColor="#2D2D44"
                    TextColor="#9E9EC8"
                    CornerRadius="8"
                    Command="{Binding SelectRangeCommand}"
                    CommandParameter="90D">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Is90DSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FC3F7" />
                        <Setter Property="TextColor" Value="#1E1E2E" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Text="1Y"
                    BackgroundColor="#2D2D44"
                    TextColor="#9E9EC8"
                    CornerRadius="8"
                    Command="{Binding SelectRangeCommand}"
                    CommandParameter="1Y">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Is1YSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FC3F7" />
                        <Setter Property="TextColor" Value="#1E1E2E" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="3"
                    Text="All"
                    BackgroundColor="#2D2D44"
                    TextColor="#9E9EC8"
                    CornerRadius="8"
                    Command="{Binding SelectRangeCommand}"
                    CommandParameter="All">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAllSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FC3F7" />
                        <Setter Property="TextColor" Value="#1E1E2E" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Chart -->
        <Grid Grid.Row="2">
            <GraphicsView
                Drawable="{Binding Chart}"
                IsVisible="{Binding HasWeightData}" />
            <Label Text="No weight data recorded yet"
                   TextColor="#555570"
                   FontSize="15"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasWeightData, Converter={StaticResource InverseBool}}" />
        </Grid>

    </Grid>
</ContentPage>
